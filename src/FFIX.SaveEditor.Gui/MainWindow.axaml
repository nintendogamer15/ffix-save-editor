<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:SaveEditor.Ui.Shell;assembly=SaveEditor.Ui"
        x:Class="FFIX.SaveEditor.Gui.MainWindow"
        Title="Final Fantasy IX Save Editor"
        Icon="avares://FFIXSaveEditor/Assets/icon.png"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
  <shell:EditorShell x:Name="Shell">
    <shell:EditorShell.Branding>
      <StackPanel>
        <TextBlock Text="FINAL FANTASY IX" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Foreground}" />
        <TextBlock Text="SAVE EDITOR" FontSize="10"
                   Foreground="{DynamicResource SubtleForeground}" />
      </StackPanel>
    </shell:EditorShell.Branding>
  </shell:EditorShell>
</Window>
