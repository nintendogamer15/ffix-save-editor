<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFIX.SaveEditor.Gui.ViewModels"
        x:Class="FFIX.SaveEditor.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Final Fantasy IX Save Editor"
        Icon="avares://FFIXSaveEditor/Assets/icon.png"
        Width="1280" Height="880" MinWidth="980" MinHeight="700">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBlock Text="Save file" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="PathBox" PlaceholderText="PS1, rr2016, or Memoria save path" />
      <Button Grid.Column="2" Content="Browse…" Click="BrowseInput" />
      <Button Grid.Column="3" Content="Load" Click="LoadFile" />
      <Button Grid.Column="4" Content="Toggle Theme" Click="ToggleTheme" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBlock Text="Save slot" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                DisplayMemberBinding="{Binding Label}" SelectionChanged="SlotChanged" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="290,*" ColumnSpacing="12">
      <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              CornerRadius="6" Padding="12">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Text="Save actions" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Gil" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="GilBox" />
              <Button Grid.Column="1" Content="Apply" Click="SetGil" />
            </Grid>
            <Button Content="Max Selected Character" Click="MaxSelected" />
            <Button Content="Max All Recruited Characters" Click="MaxAll" />
            <Button Content="Give All Items and Gear" Click="GiveAllItems" />

            <Separator Margin="0,6" />
            <TextBlock Text="Add item / gear" FontWeight="SemiBold" />
            <ComboBox x:Name="KnownItemCombo" ItemsSource="{Binding KnownItems}"
                      SelectionChanged="KnownItemSelected" PlaceholderText="Pick from list…" />
            <TextBox x:Name="ItemBox" PlaceholderText="Name, decimal ID, or 0xID" />
            <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8">
              <TextBlock Text="Qty" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" x:Name="QuantityBox" Minimum="1" Maximum="99" Value="99" />
              <Button Grid.Column="2" Content="Add" Click="AddItem" />
            </Grid>

            <Separator Margin="0,6" />
            <TextBlock Text="All edits remain in memory until you write a new file or explicitly choose in-place writing."
                       TextWrapping="Wrap" Opacity="0.75" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <TabControl Grid.Column="1">
        <TabItem Header="Overview">
          <TextBlock Text="{Binding Overview}" Margin="14" TextWrapping="Wrap" FontSize="15" />
        </TabItem>

        <TabItem Header="Characters">
          <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="8">
            <DataGrid Grid.Row="0" x:Name="CharacterGrid" ItemsSource="{Binding Characters}"
                      SelectedItem="{Binding SelectedCharacter}" SelectionChanged="CharacterChanged"
                      IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" />
                <DataGridTextColumn Header="EXP" Binding="{Binding Experience}" />
                <DataGridTextColumn Header="HP" Binding="{Binding Hp}" />
                <DataGridTextColumn Header="MP" Binding="{Binding Mp}" />
                <DataGridTextColumn Header="STR" Binding="{Binding Strength}" />
                <DataGridTextColumn Header="SPD" Binding="{Binding Speed}" />
                <DataGridTextColumn Header="MAG" Binding="{Binding Magic}" />
                <DataGridTextColumn Header="SPR" Binding="{Binding Spirit}" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    CornerRadius="5" Padding="10">
              <Grid ColumnDefinitions="Auto,100,Auto,110,Auto,110,Auto,110" RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="6" RowSpacing="6">
                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="NameBox" />
                <TextBlock Grid.Column="2" Text="Level" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" x:Name="LevelBox" />
                <TextBlock Grid.Column="4" Text="EXP" VerticalAlignment="Center" />
                <TextBox Grid.Column="5" x:Name="ExperienceBox" />
                <Button Grid.Column="7" Content="Apply Character" Click="ApplyCharacter" />

                <TextBlock Grid.Row="1" Text="HP current / max" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CurrentHpBox" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="MaximumHpBox" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="MP current / max" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="CurrentMpBox" />
                <TextBox Grid.Row="1" Grid.Column="7" x:Name="MaximumMpBox" />

                <TextBlock Grid.Row="2" Text="Strength" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="StrengthBox" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Speed" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="SpeedBox" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="Magic" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="5" x:Name="MagicBox" />
                <TextBlock Grid.Row="2" Grid.Column="6" Text="Spirit" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="7" x:Name="SpiritBox" />

                <TextBlock Grid.Row="3" Text="Equipment IDs" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="WeaponBox" PlaceholderText="Weapon" />
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="HeadBox" PlaceholderText="Head" />
                <TextBox Grid.Row="3" Grid.Column="5" x:Name="ArmBox" PlaceholderText="Arm" />
                <TextBox Grid.Row="3" Grid.Column="6" x:Name="ArmorBox" PlaceholderText="Armor" />
                <TextBox Grid.Row="3" Grid.Column="7" x:Name="AccessoryBox" PlaceholderText="Accessory" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Support Abilities (PS1)">
          <Grid RowDefinitions="*,Auto" Margin="8" RowSpacing="8">
            <ScrollViewer Grid.Row="0">
              <ItemsControl ItemsSource="{Binding Abilities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AbilityChoice">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="1" Content="Apply Support Abilities" HorizontalAlignment="Left" Click="ApplyAbilities" />
          </Grid>
        </TabItem>

        <TabItem Header="Inventory">
          <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal" Margin="8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Slot" Binding="{Binding SlotIndex}" />
              <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>

        <TabItem Header="Tetra Master Cards">
          <DataGrid ItemsSource="{Binding Cards}" IsReadOnly="True" AutoGenerateColumns="False"
                    GridLinesVisibility="Horizontal" Margin="8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index}" />
              <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*" />
              <DataGridTextColumn Header="Attack" Binding="{Binding Attack}" />
              <DataGridTextColumn Header="Attack Type" Binding="{Binding AttackTypeName}" />
              <DataGridTextColumn Header="Physical Def." Binding="{Binding PhysicalDefense}" />
              <DataGridTextColumn Header="Magic Def." Binding="{Binding MagicDefense}" />
              <DataGridTextColumn Header="Arrows" Binding="{Binding Arrows}" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            CornerRadius="6" Padding="10" Margin="0,10,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Output" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="OutputBox" PlaceholderText="Blank creates an .edited copy beside the input" />
        <Button Grid.Column="2" Content="Browse…" Click="BrowseOutput" />
        <Button Grid.Column="3" Content="Write New File" Click="WriteNew" />
        <Button Grid.Column="4" Content="Write In-Place" Click="WriteInPlace" />
      </Grid>
    </Border>

    <TextBox Grid.Row="4" Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
             Height="100" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </Grid>
</Window>
